{
  "name": "@twobots/ui-theme",
  "version": "0.4.0",
  "description": "Shared visual material for the twobots.dev card-game lineup — design tokens, generic card rendering, table-shell chrome, a dialog/sheet overlay shell, and the rail header strip + utility-button + control. Ships raw source; consuming apps compile it with their own Vite/TypeScript pipeline.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjornbasar/otso.git"
  },
  "files": [
    "src"
  ],
  "exports": {
    "./tokens.css": "./src/tokens.css",
    "./table-surface.css": "./src/table-surface.css",
    "./card.css": "./src/card/card.css",
    "./card": "./src/card/index.ts",
    "./overlay.css": "./src/overlay/overlay.css",
    "./rail.css": "./src/rail/rail.css",
    "./rail": "./src/rail/index.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
